# Copy to .env with `make env`, which fills in the two values below. .env is git-ignored.
# Nothing here is a real secret; the password is generated on your machine.
POSTGRES_PASSWORD=generated-by-make-env
# Group id of /var/run/docker.sock as containers see it: `stat -c %g /var/run/docker.sock`
# on Linux; 0 on Docker Desktop (the socket inside containers is root:root, mode 660).
DOCKER_GID=0

# Optional
# MODEL_NAME=qwen2.5-vl-7b-instruct-q4_k_m
# DEFAULT_TOKEN_BUDGET=2000000
# SANDBOX_POOL_SIZE=4
# SANDBOX_TIMEOUT_S=5
# SANDBOX_RUNTIME=runsc   # gVisor, if installed on the host (not available on Docker Desktop)
# MODEL_TIMEOUT_S=900     # one model call; CPU inference takes minutes per page
# LEASE_S=3600            # a job's lease; keep it above 3 x MODEL_TIMEOUT_S
